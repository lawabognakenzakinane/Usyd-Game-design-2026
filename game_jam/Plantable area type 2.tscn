[sub_resource type="GDScript" id="GDScript_x7ufw"]
script/source = "class_name Plant_area_2
extends StaticBody2D

var global=preload(\"res://game.gd\")

var is_digged=false
var emu=preload(\"res://emu_bush.gd\")
var citru=preload(\"res://citrus_australasica_x.gd\")
var eucalyptus=preload(\"res://eucalyptus_gillii.gd\")
@onready var plant = $plant

# Creation of custom signal
signal plant_is_planted

func _on_control_type_2_gui_input(event: InputEvent) -> void:
	if Input.is_action_pressed(\"pressed\")==true:
		match global.current_state:
			global.State.DIGGING_MODE:
				plant.play(\"dig\")
				is_digged=true
			global.State.PLANT_MODE:
				if is_digged==true:
					# EMit signal
					plant_is_planted.emit()
				else:
					global.cant_plant=true
					
"

